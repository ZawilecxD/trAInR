---
const features = [
  {
    title: "Build session templates",
    body: "Compose reusable workouts with phases, exercises, and prescribed sets once — then reuse them across your whole roster.",
    icon: "layers" as const,
  },
  {
    title: "Assign to clients",
    body: "Drop sessions onto a client's calendar and onboard them in seconds with a single-use invite link.",
    icon: "calendar" as const,
  },
  {
    title: "Review what they logged",
    body: "Compare planned vs. actual reps, weights, and RPE, then leave feedback right in the session thread.",
    icon: "clipboard" as const,
  },
];
---

<div class="bg-background relative min-h-screen w-full overflow-hidden">
  <!-- Cosmic atmosphere -->
  <div
    class="bg-primary/20 pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-primary/10 pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full blur-[100px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-primary/10 pointer-events-none absolute top-0 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full blur-[140px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 opacity-80"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.12) 1px, transparent 1px), radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 200px 200px, 140px 140px; background-position: 0 0, 50px 70px;"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10">
    <!-- Hero — brand as the hero signal -->
    <section
      class="mx-auto flex max-w-4xl flex-col items-center px-5 pt-16 pb-16 text-center sm:px-8 sm:pt-24 sm:pb-20 lg:pt-28"
    >
      <h1
        class="text-brand-gradient display-hero animate-welcome-in mb-6 text-5xl leading-none sm:text-6xl lg:text-[5.5rem]"
      >
        trAInR
      </h1>
      <p
        class="text-text-soft animate-welcome-in mb-10 max-w-xl text-base leading-relaxed sm:text-lg"
        style="animation-delay: 80ms"
      >
        Async coaching for independent personal trainers. Build session templates, assign them to clients, and review
        what they actually logged at the gym.
      </p>
      <div
        class="animate-welcome-in flex w-full max-w-sm flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center"
        style="animation-delay: 160ms"
      >
        <a
          href="/auth/signup"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex min-h-11 items-center justify-center rounded-[var(--radius)] px-6 py-3 text-[15px] font-semibold transition-colors"
        >
          Get started
        </a>
        <a
          href="/auth/signin"
          class="bg-secondary text-secondary-foreground hover:bg-secondary/80 inline-flex min-h-11 items-center justify-center rounded-[var(--radius)] px-6 py-3 text-[15px] font-semibold transition-colors"
        >
          Sign in
        </a>
      </div>
    </section>

    <!-- Product pillars -->
    <section class="mx-auto grid max-w-5xl grid-cols-1 gap-4 px-5 pb-20 sm:grid-cols-3 sm:gap-6 sm:px-8 sm:pb-28">
      {
        features.map(({ title, body, icon }, i) => (
          <article
            class="surface-card animate-welcome-in flex flex-col gap-3.5 p-5 sm:p-7"
            style={`animation-delay: ${220 + i * 70}ms`}
          >
            <div class="bg-accent text-text-lavender flex size-12 items-center justify-center rounded-[var(--radius-md)]">
              {icon === "layers" ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
                  <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
                  <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
                </svg>
              ) : icon === "calendar" ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M8 2v4" />
                  <path d="M16 2v4" />
                  <rect width="18" height="18" x="3" y="4" rx="2" />
                  <path d="M3 10h18" />
                  <path d="M8 14h.01" />
                  <path d="M12 14h.01" />
                  <path d="M16 14h.01" />
                  <path d="M8 18h.01" />
                  <path d="M12 18h.01" />
                  <path d="M16 18h.01" />
                </svg>
              ) : (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                  <path d="M12 11h4" />
                  <path d="M12 16h4" />
                  <path d="M8 11h.01" />
                  <path d="M8 16h.01" />
                </svg>
              )}
            </div>
            <h2 class="text-foreground text-lg font-semibold">{title}</h2>
            <p class="text-text-soft text-sm leading-relaxed">{body}</p>
          </article>
        ))
      }
    </section>
  </div>
</div>

<style>
  @keyframes welcome-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-welcome-in {
    animation: welcome-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-welcome-in {
      animation: none;
    }
  }
</style>
