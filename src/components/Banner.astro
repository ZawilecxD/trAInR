---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: color-mix(in srgb, var(--primary) 15%, var(--card));
    color: var(--text-lavender);
    border-color: color-mix(in srgb, var(--primary) 30%, transparent);
  }
  .banner--warning {
    background: color-mix(in srgb, var(--warning) 15%, var(--card));
    color: var(--warning);
    border-color: color-mix(in srgb, var(--warning) 30%, transparent);
  }
  .banner--error {
    background: color-mix(in srgb, var(--destructive) 15%, var(--card));
    color: var(--destructive);
    border-color: color-mix(in srgb, var(--destructive) 30%, transparent);
  }
</style>
