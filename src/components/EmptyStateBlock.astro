---
import { cn } from "@/lib/utils";
import { surfaceCardClass } from "@/lib/ui-classes";

interface Props {
  title: string;
  description?: string;
  className?: string;
}

const { title, description, className } = Astro.props;
---

<div class:list={cn(surfaceCardClass, "px-6 py-10 text-center", className)}>
  <p class="text-foreground text-lg font-medium">{title}</p>
  {description ? <p class="text-muted-foreground mt-2 text-sm">{description}</p> : null}
  <div class="mt-4 flex justify-center empty:hidden">
    <slot name="action" />
  </div>
</div>
