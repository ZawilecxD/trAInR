---
import { cn } from "@/lib/utils";

const { user, role } = Astro.locals;
const pathname = Astro.url.pathname;

interface NavItem {
  href: string;
  label: string;
}

function isActive(href: string): boolean {
  if (href === "/dashboard") {
    return pathname === "/dashboard";
  }
  return pathname === href || pathname.startsWith(`${href}/`);
}

function navLinkClass(href: string): string {
  return cn(
    "rounded-[var(--radius)] px-3 py-1.5 text-sm transition-colors",
    isActive(href)
      ? "bg-accent font-semibold text-foreground shadow-sm"
      : "text-muted-foreground hover:bg-accent/60 hover:text-foreground",
  );
}

const trainerNav: NavItem[] = [
  { href: "/trainer/dashboard", label: "Dashboard" },
  { href: "/trainer/clients", label: "Clients" },
  { href: "/trainer/exercises", label: "Exercises" },
  { href: "/trainer/templates", label: "Templates" },
];

const clientNav: NavItem[] = [
  { href: "/client/dashboard", label: "Dashboard" },
  { href: "/client/plan", label: "My Plan" },
  { href: "/client/exercises", label: "Exercises" },
];

let navItems: NavItem[] = [];
if (user) {
  if (role === "trainer") {
    navItems = trainerNav;
  } else if (role === "client") {
    navItems = clientNav;
  } else {
    navItems = [{ href: "/dashboard", label: "Dashboard" }];
  }
}

const homeHref =
  user && role === "trainer"
    ? "/trainer/dashboard"
    : user && role === "client"
      ? "/client/dashboard"
      : user
        ? "/dashboard"
        : "/";

/** Primary link row is desktop-only when role bottom nav owns mobile chrome. */
const hidePrimaryNavOnMobile = Boolean(user && (role === "trainer" || role === "client"));

const accountInitial = user?.email?.charAt(0)?.toUpperCase() ?? "?";
---

<header
  class="border-border bg-background/90 sticky top-0 z-50 h-14 border-b backdrop-blur-md"
  aria-label="Main navigation"
>
  <div class="mx-auto flex h-full max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <div class="flex min-w-0 flex-1 items-center gap-4 sm:gap-6">
      <a href={homeHref} class="text-primary shrink-0 text-sm font-bold tracking-wide sm:text-base"> trAInR </a>

      {
        navItems.length > 0 ? (
          <nav class:list={cn("flex items-center gap-1", hidePrimaryNavOnMobile && "hidden md:flex")} aria-label="App">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={navLinkClass(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        ) : null
      }
    </div>

    <div class="flex shrink-0 items-center gap-2 text-sm sm:gap-3">
      {
        user ? (
          <>
            <span
              class="bg-primary/20 text-primary flex size-8 items-center justify-center rounded-full text-xs font-semibold md:hidden"
              aria-hidden="true"
            >
              {accountInitial}
            </span>
            <span class="text-muted-foreground hidden max-w-[12rem] truncate sm:max-w-xs md:inline" title={user.email}>
              {user.email}
            </span>
            <form method="POST" action="/api/auth/signout">
              <button
                type="submit"
                class="text-muted-foreground hover:bg-accent hover:text-foreground min-h-9 rounded-[var(--radius)] px-3 py-1.5 transition-colors"
              >
                Sign out
              </button>
            </form>
          </>
        ) : (
          <>
            <a href="/auth/signin" class:list={navLinkClass("/auth/signin")}>
              Sign in
            </a>
            <a
              href="/auth/signup"
              class:list={cn(
                "rounded-[var(--radius)] px-3 py-1.5 text-sm font-medium transition-colors",
                isActive("/auth/signup")
                  ? "bg-accent text-foreground"
                  : "border-border bg-muted text-foreground hover:bg-accent border",
              )}
            >
              Sign up
            </a>
          </>
        )
      }
    </div>
  </div>
</header>
