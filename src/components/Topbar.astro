---
import { cn } from "@/lib/utils";

const { user, role } = Astro.locals;
const pathname = Astro.url.pathname;

interface NavItem {
  href: string;
  label: string;
}

function isActive(href: string): boolean {
  if (href === "/dashboard") {
    return pathname === "/dashboard";
  }
  return pathname === href || pathname.startsWith(`${href}/`);
}

function navLinkClass(href: string): string {
  return cn(
    "rounded-md px-3 py-1.5 text-sm transition-colors",
    isActive(href) ? "bg-white/15 font-semibold text-white" : "text-blue-100/70 hover:bg-white/10 hover:text-white",
  );
}

const trainerNav: NavItem[] = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/trainer/clients", label: "Clients" },
];

const clientNav: NavItem[] = [{ href: "/dashboard", label: "Dashboard" }];

let navItems: NavItem[] = [];
if (user) {
  if (role === "trainer") {
    navItems = trainerNav;
  } else if (role === "client") {
    navItems = clientNav;
  } else {
    navItems = [{ href: "/dashboard", label: "Dashboard" }];
  }
}

const homeHref = user ? "/dashboard" : "/";
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/85 backdrop-blur-md"
  aria-label="Main navigation"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <div class="flex min-w-0 flex-1 items-center gap-4 sm:gap-6">
      <a
        href={homeHref}
        class="shrink-0 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-sm font-bold tracking-wide text-transparent sm:text-base"
      >
        trAInR
      </a>

      {
        navItems.length > 0 ? (
          <nav class="flex flex-wrap items-center gap-1" aria-label="App">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={navLinkClass(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        ) : null
      }
    </div>

    <div class="flex shrink-0 items-center gap-3 text-sm">
      {
        user ? (
          <>
            <span class="max-w-[12rem] truncate text-blue-100/70 sm:max-w-xs" title={user.email}>
              {user.email}
            </span>
            <form method="POST" action="/api/auth/signout">
              <button
                type="submit"
                class="rounded-md px-3 py-1.5 text-blue-100/70 transition-colors hover:bg-white/10 hover:text-white"
              >
                Sign out
              </button>
            </form>
          </>
        ) : (
          <>
            <a href="/auth/signin" class:list={navLinkClass("/auth/signin")}>
              Sign in
            </a>
            <a
              href="/auth/signup"
              class:list={cn(
                "rounded-md px-3 py-1.5 text-sm font-medium transition-colors",
                isActive("/auth/signup")
                  ? "bg-white/15 text-white"
                  : "border border-white/20 bg-white/10 text-white hover:bg-white/20",
              )}
            >
              Sign up
            </a>
          </>
        )
      }
    </div>
  </div>
</header>
