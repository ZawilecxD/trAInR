---
const { user, role } = Astro.locals;

const navLinkClass = "text-purple-300 transition-colors hover:text-purple-100 hover:underline";
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class:list={navLinkClass}>
            Dashboard
          </a>
          {role === "trainer" ? (
            <a href="/trainer/exercises" class:list={navLinkClass}>
              Exercise library
            </a>
          ) : null}
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={navLinkClass}>
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class:list={navLinkClass}>
            Sign in
          </a>
          <a href="/auth/signup" class:list={navLinkClass}>
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
