---
import Layout from "@/layouts/Layout.astro";
import AuthPageShell from "@/components/auth/AuthPageShell.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { createClient } from "@/lib/supabase";
import type { InviteValidation } from "@/types";

const error = Astro.url.searchParams.get("error");
const token = Astro.url.searchParams.get("token");

let trainerName: string | undefined;
let tokenInvalid = false;
let tokenValid = false;

if (token) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    tokenInvalid = true;
  } else {
    const validationResult = await supabase.rpc("validate_invite_token", {
      p_token: token,
    });

    if (validationResult.error || validationResult.data === null) {
      tokenInvalid = true;
    } else {
      const validation = validationResult.data as InviteValidation;
      if (!validation.valid) {
        tokenInvalid = true;
      } else {
        tokenValid = true;
        trainerName = validation.trainer_display_name ?? undefined;
      }
    }
  }
}

const isClientInvite = Boolean(token && tokenValid);
const pageTitle = isClientInvite ? "Join as client" : "Sign up";
---

<Layout title={pageTitle}>
  <AuthPageShell centered={Boolean(token && tokenInvalid)}>
    {
      token && tokenInvalid ? (
        <>
          <h1 class="text-brand-gradient headline-lg text-2xl md:text-[26px]">Invite link unavailable</h1>
          <p class="text-text-soft text-sm">
            This invite link is invalid, expired, or has already been used. Ask your trainer to send you a new link.
          </p>
          <p class="text-muted-foreground mt-2 text-[13px]">
            <a href="/auth/signin" class="text-text-lavender font-semibold hover:underline">
              Sign in
            </a>{" "}
            if you already have an account.
          </p>
        </>
      ) : (
        <>
          <h1
            class:list={[
              "text-brand-gradient headline-lg text-center",
              isClientInvite ? "text-[21px] md:text-[23px]" : "text-2xl md:text-[26px]",
            ]}
          >
            {isClientInvite ? "Create your client account" : "Sign up"}
          </h1>
          {isClientInvite ? (
            <div class="bg-primary/10 flex items-center justify-center gap-1.5 rounded-[var(--radius)] px-3 py-2.5 text-[13px]">
              <span class="text-text-soft">Invited by</span>
              <span class="text-foreground font-bold">{trainerName ?? "your trainer"}</span>
            </div>
          ) : null}
          <SignUpForm serverError={error} token={token ?? undefined} trainerName={trainerName} client:load />
          <p class="text-muted-foreground flex flex-wrap items-center justify-center gap-1.5 text-[13px]">
            <span>Already have an account?</span>
            <a href="/auth/signin" class="text-text-lavender font-semibold hover:underline">
              Sign in
            </a>
          </p>
        </>
      )
    }
  </AuthPageShell>
</Layout>
