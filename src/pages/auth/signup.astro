---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { createClient } from "@/lib/supabase";
import type { InviteValidation } from "@/types";

const error = Astro.url.searchParams.get("error");
const token = Astro.url.searchParams.get("token");

let trainerName: string | undefined;
let tokenInvalid = false;
let tokenValid = false;

if (token) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    tokenInvalid = true;
  } else {
    const validationResult = await supabase.rpc("validate_invite_token", {
      p_token: token,
    });

    if (validationResult.error || validationResult.data === null) {
      tokenInvalid = true;
    } else {
      const validation = validationResult.data as InviteValidation;
      if (!validation.valid) {
        tokenInvalid = true;
      } else {
        tokenValid = true;
        trainerName = validation.trainer_display_name ?? undefined;
      }
    }
  }
}

const isClientInvite = Boolean(token && tokenValid);
const pageTitle = isClientInvite ? "Join as client" : "Sign up";
---

<Layout title={pageTitle}>
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-muted text-foreground w-full max-w-sm rounded-2xl border p-8 backdrop-blur-xl">
      {
        token && tokenInvalid ? (
          <>
            <h1 class="headline-lg text-foreground mb-4 text-center text-2xl">Invite link unavailable</h1>
            <p class="text-muted-foreground text-center text-sm">
              This invite link is invalid, expired, or has already been used. Ask your trainer to send you a new link.
            </p>
            <p class="text-muted-foreground mt-6 text-center text-sm">
              <a href="/auth/signin" class="text-text-lavender hover:underline">
                Sign in
              </a>{" "}
              if you already have an account.
            </p>
          </>
        ) : (
          <>
            <h1 class="headline-lg text-foreground mb-6 text-center text-2xl">
              {isClientInvite ? "Create your client account" : "Sign up"}
            </h1>
            {isClientInvite ? (
              <p class="text-muted-foreground mb-4 text-center text-sm">
                You've been invited by{" "}
                <span class="text-foreground font-semibold">{trainerName ?? "your trainer"}</span>
              </p>
            ) : null}
            <SignUpForm serverError={error} token={token ?? undefined} trainerName={trainerName} client:load />
            <p class="text-muted-foreground mt-4 text-center text-sm">
              Already have an account?{" "}
              <a href="/auth/signin" class="text-text-lavender hover:underline">
                Sign in
              </a>
            </p>
          </>
        )
      }
    </div>
  </div>
</Layout>
