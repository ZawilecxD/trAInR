---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { createClient } from "@/lib/supabase";
import type { InviteValidation } from "@/types";

const error = Astro.url.searchParams.get("error");
const token = Astro.url.searchParams.get("token");

let trainerName: string | undefined;
let tokenInvalid = false;
let tokenValid = false;

if (token) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    tokenInvalid = true;
  } else {
    const validationResult = await supabase.rpc("validate_invite_token", {
      p_token: token,
    });

    if (validationResult.error || validationResult.data === null) {
      tokenInvalid = true;
    } else {
      const validation = validationResult.data as InviteValidation;
      if (!validation.valid) {
        tokenInvalid = true;
      } else {
        tokenValid = true;
        trainerName = validation.trainer_display_name ?? undefined;
      }
    }
  }
}

const isClientInvite = Boolean(token && tokenValid);
const pageTitle = isClientInvite ? "Join as client" : "Sign up";
---

<Layout title={pageTitle}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {
        token && tokenInvalid ? (
          <>
            <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
              Invite link unavailable
            </h1>
            <p class="text-center text-sm text-blue-100/80">
              This invite link is invalid, expired, or has already been used. Ask your trainer to send you a new link.
            </p>
            <p class="mt-6 text-center text-sm text-blue-100/60">
              <a href="/auth/signin" class="text-purple-300 hover:underline">
                Sign in
              </a>{" "}
              if you already have an account.
            </p>
          </>
        ) : (
          <>
            <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
              {isClientInvite ? "Create your client account" : "Sign up"}
            </h1>
            {isClientInvite ? (
              <p class="mb-4 text-center text-sm text-blue-100/80">
                You've been invited by <span class="font-semibold text-white">{trainerName ?? "your trainer"}</span>
              </p>
            ) : null}
            <SignUpForm serverError={error} token={token ?? undefined} trainerName={trainerName} client:load />
            <p class="mt-4 text-center text-sm text-blue-100/60">
              Already have an account?{" "}
              <a href="/auth/signin" class="text-purple-300 hover:underline">
                Sign in
              </a>
            </p>
          </>
        )
      }
    </div>
  </div>
</Layout>
