---
import Layout from "@/layouts/Layout.astro";
import ExerciseStatsView from "@/components/exercise-stats/ExerciseStatsView";
import { getExerciseHistoryForClient } from "@/lib/exercise-stats/service";
import { createClient } from "@/lib/supabase";
import { pageShellClass } from "@/lib/ui-classes";
import { z } from "zod";

export const prerender = false;

const exerciseIdSchema = z.uuid();

const userId = Astro.locals.user?.id;
const parsedExerciseId = exerciseIdSchema.safeParse(Astro.params.exerciseId);
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!parsedExerciseId.success || !supabase || !userId) {
  return Astro.redirect("/client/exercises");
}

const { data: history, error } = await getExerciseHistoryForClient(supabase, userId, parsedExerciseId.data);

if (error || !history) {
  return Astro.redirect("/client/exercises");
}
---

<Layout title={history.exercise.name}>
  <div class:list={pageShellClass}>
    <div class="mx-auto max-w-3xl space-y-6">
      <div>
        <a href="/client/exercises" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
          ← All exercises
        </a>
        <h1 class="headline-lg text-foreground mt-2 text-balance">{history.exercise.name}</h1>
        <p class="text-muted-foreground mt-1 text-sm">Your logged performance across sessions.</p>
      </div>

      <ExerciseStatsView client:load history={history} />
    </div>
  </div>
</Layout>
