---
import Layout from "@/layouts/Layout.astro";
import { listLoggedExercisesForClient } from "@/lib/exercise-stats/service";
import { createClient } from "@/lib/supabase";
import type { ExerciseMetric } from "@/types";

export const prerender = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !Astro.locals.user?.id) {
  return Astro.redirect("/client/dashboard");
}

const { data: exercises, error } = await listLoggedExercisesForClient(supabase, Astro.locals.user.id);

const metricLabels: Record<ExerciseMetric, string> = {
  reps_weight: "Reps & weight",
  time: "Time",
  distance: "Distance",
};

function formatLoggedAt(iso: string): string {
  const date = new Date(iso);
  const day = String(date.getUTCDate()).padStart(2, "0");
  const month = String(date.getUTCMonth() + 1).padStart(2, "0");
  const year = date.getUTCFullYear();
  return `${day}.${month}.${year}`;
}
---

<Layout title="Exercise stats">
  <div class="bg-cosmic min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-3xl space-y-6">
      <div>
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Exercise stats
        </h1>
        <p class="mt-1 text-sm text-blue-100/70">
          Your logged exercises — tap one to see history, estimated 1RM, and volume.
        </p>
      </div>

      {
        error ? (
          <div class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            Failed to load exercise stats: {error}
          </div>
        ) : !exercises || exercises.length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center">
            <p class="text-sm text-blue-100/70">No stats yet. Log a workout and your exercises will show up here.</p>
          </div>
        ) : (
          <ul class="space-y-2">
            {exercises.map((exercise) => (
              <li>
                <a
                  href={`/client/exercises/${exercise.exerciseId}`}
                  class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 transition-colors hover:border-white/20 hover:bg-white/10"
                >
                  <div class="min-w-0">
                    <p class="truncate font-medium text-white">{exercise.name}</p>
                    <p class="mt-0.5 text-xs text-blue-100/60">
                      {metricLabels[exercise.defaultMetric]} · last logged {formatLoggedAt(exercise.lastLoggedAt)}
                    </p>
                  </div>
                  <span class="shrink-0 text-xs text-blue-100/60">
                    {exercise.sessionCount} session{exercise.sessionCount === 1 ? "" : "s"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
