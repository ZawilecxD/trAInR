---
import Layout from "@/layouts/Layout.astro";
import ClientExercisesHub from "@/components/exercise-stats/ClientExercisesHub";
import { listLoggedExercisesForClient } from "@/lib/exercise-stats/service";
import { createClient } from "@/lib/supabase";
import { pageShellClass } from "@/lib/ui-classes";

export const prerender = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !Astro.locals.user?.id) {
  return Astro.redirect("/client/dashboard");
}

const { data, error } = await listLoggedExercisesForClient(supabase, Astro.locals.user.id);
---

<Layout title="Exercise stats">
  <div class:list={pageShellClass}>
    <ClientExercisesHub payload={data} error={error} />
  </div>
</Layout>
