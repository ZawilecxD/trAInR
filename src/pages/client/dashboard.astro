---
import ClientDashboardHub from "@/components/client/ClientDashboardHub";
import Layout from "@/layouts/Layout.astro";
import { addDays } from "date-fns";
import { selectFocusSession, selectUpcomingSessions } from "@/lib/client-dashboard/next-session";
import { toLocalISODate } from "@/lib/dates";
import { pageShellClass } from "@/lib/ui-classes";
import { createClient } from "@/lib/supabase";
import { listMySessionsAsClient } from "@/lib/workout-sessions/service";
import type { AssignedTrainer } from "@/types";

const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let clientName = "Athlete";
let trainerName: string | null = null;
let hasActivePlan = false;
let loadError: string | null = null;
let focusSession = null as ReturnType<typeof selectFocusSession>;
let upcomingSessions: NonNullable<typeof focusSession>[] = [];

const today = new Date();
const todayIso = toLocalISODate(today);
const hour = today.getHours();
const greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

if (supabase && userId) {
  const [profileResult, trainerResult, planResult] = await Promise.all([
    supabase.from("profiles").select("display_name").eq("id", userId).maybeSingle(),
    supabase.rpc("get_my_assigned_trainer"),
    supabase.from("client_plans").select("id").eq("client_id", userId).eq("status", "active").maybeSingle(),
  ]);

  if (typeof profileResult.data?.display_name === "string" && profileResult.data.display_name.trim()) {
    clientName = profileResult.data.display_name.trim();
  }

  if (!trainerResult.error && trainerResult.data) {
    trainerName = (trainerResult.data as AssignedTrainer).display_name;
  } else if (trainerResult.error?.code === "PGRST202") {
    const assignmentResult = await supabase
      .from("trainer_clients")
      .select("trainer_id, trainer:profiles!trainer_id(display_name)")
      .eq("client_id", userId)
      .eq("status", "active")
      .order("assigned_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (!assignmentResult.error && assignmentResult.data) {
      const row = assignmentResult.data as {
        trainer: { display_name: string } | { display_name: string }[] | null;
      };
      const trainerData = row.trainer;
      const trainer = Array.isArray(trainerData) ? trainerData[0] : trainerData;
      trainerName = trainer?.display_name ?? null;
    }
  }

  hasActivePlan = Boolean(planResult.data?.id) && !planResult.error;

  if (planResult.error) {
    loadError = planResult.error.message;
  } else if (hasActivePlan) {
    const rangeTo = toLocalISODate(addDays(today, 42));
    const { data: sessions, error: sessionsError } = await listMySessionsAsClient(supabase, userId, todayIso, rangeTo);

    if (sessionsError) {
      loadError = sessionsError;
    } else {
      const list = sessions ?? [];
      focusSession = selectFocusSession(list, todayIso);
      upcomingSessions = selectUpcomingSessions(list, todayIso, focusSession?.id ?? null, 3);
    }
  }
}
---

<Layout title="Dashboard">
  <div class:list={pageShellClass}>
    <ClientDashboardHub
      clientName={clientName}
      trainerName={trainerName}
      greeting={greeting}
      todayIso={todayIso}
      focusSession={focusSession}
      upcomingSessions={upcomingSessions}
      hasActivePlan={hasActivePlan}
      loadError={loadError}
    />
  </div>
</Layout>
