---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { AssignedTrainer } from "@/types";

const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let trainerName: string | null = null;

if (supabase && userId) {
  const trainerResult = await supabase.rpc("get_my_assigned_trainer");

  if (!trainerResult.error && trainerResult.data) {
    trainerName = (trainerResult.data as AssignedTrainer).display_name;
  } else if (trainerResult.error?.code === "PGRST202") {
    const assignmentResult = await supabase
      .from("trainer_clients")
      .select("trainer_id, trainer:profiles!trainer_id(display_name)")
      .eq("client_id", userId)
      .eq("status", "active")
      .order("assigned_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (!assignmentResult.error && assignmentResult.data) {
      const row = assignmentResult.data as {
        trainer: { display_name: string } | { display_name: string }[] | null;
      };
      const trainerData = row.trainer;
      const trainer = Array.isArray(trainerData) ? trainerData[0] : trainerData;
      trainerName = trainer?.display_name ?? null;
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Welcome
      </h1>
      {
        trainerName ? (
          <p class="text-blue-100/80">
            You're training with <span class="font-semibold text-white">{trainerName}</span>
          </p>
        ) : (
          <p class="text-blue-100/80">Your trainer will assign your first plan soon.</p>
        )
      }
      <p class="mt-4 text-sm text-blue-100/50">View your assigned workouts on your training calendar.</p>
      <a
        href="/client/plan"
        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-purple-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-purple-500/90"
      >
        My Plan
      </a>
    </div>
  </div>
</Layout>
