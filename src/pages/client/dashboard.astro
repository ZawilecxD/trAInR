---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { AssignedTrainer } from "@/types";

const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let trainerName: string | null = null;

if (supabase && userId) {
  const trainerResult = await supabase.rpc("get_my_assigned_trainer");

  if (!trainerResult.error && trainerResult.data) {
    trainerName = (trainerResult.data as AssignedTrainer).display_name;
  } else if (trainerResult.error?.code === "PGRST202") {
    const assignmentResult = await supabase
      .from("trainer_clients")
      .select("trainer_id, trainer:profiles!trainer_id(display_name)")
      .eq("client_id", userId)
      .eq("status", "active")
      .order("assigned_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (!assignmentResult.error && assignmentResult.data) {
      const row = assignmentResult.data as {
        trainer: { display_name: string } | { display_name: string }[] | null;
      };
      const trainerData = row.trainer;
      const trainer = Array.isArray(trainerData) ? trainerData[0] : trainerData;
      trainerName = trainer?.display_name ?? null;
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div
      class="border-border bg-muted text-foreground w-full max-w-md rounded-2xl border p-8 text-center backdrop-blur-xl"
    >
      <h1 class="headline-lg text-foreground mb-4">Welcome</h1>
      {
        trainerName ? (
          <p class="text-muted-foreground">
            You're training with <span class="text-foreground font-semibold">{trainerName}</span>
          </p>
        ) : (
          <p class="text-muted-foreground">Your trainer will assign your first plan soon.</p>
        )
      }
      <p class="text-muted-foreground mt-4 text-sm">View your assigned workouts on your training calendar.</p>
      <a
        href="/client/plan"
        class="bg-primary hover:bg-primary/90 text-primary-foreground mt-6 inline-flex min-h-11 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors"
      >
        My Plan
      </a>
    </div>
  </div>
</Layout>
