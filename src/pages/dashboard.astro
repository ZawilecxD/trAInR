---
import Layout from "@/layouts/Layout.astro";

const { user, role } = Astro.locals;

const roleDashboard = role === "trainer" ? "/trainer/dashboard" : role === "client" ? "/client/dashboard" : null;

if (roleDashboard) {
  return Astro.redirect(roleDashboard);
}
---

<Layout title="Dashboard">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-muted rounded-2xl border p-8 text-center text-white backdrop-blur-xl">
      <h1 class="headline-lg text-foreground mb-4">Dashboard</h1>
      <p class="text-muted-foreground">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="text-muted-foreground mt-2 text-sm">This page is only for authenticated users.</p>
      {
        Astro.locals.role === "trainer" ? (
          <p class="text-muted-foreground mt-4 text-sm">
            <a href="/trainer/clients" class="text-text-lavender hover:underline">
              Manage clients and invites
            </a>
          </p>
        ) : null
      }
    </div>
  </div>
</Layout>
