---
import Layout from "@/layouts/Layout.astro";
import TemplateForm from "@/components/session-templates/TemplateForm";
import { listExercises } from "@/lib/exercises/service";
import { getTemplate } from "@/lib/session-templates/service";
import { templateIdParamSchema } from "@/lib/session-templates/schemas";
import { createClient } from "@/lib/supabase";

const userId = Astro.locals.user?.id;
const rawId = Astro.params.id;
const parsedId = templateIdParamSchema.safeParse(rawId);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadError: string | null = null;
let notFound = false;
let template: Awaited<ReturnType<typeof getTemplate>>["data"] = null;
let availableExercises: Awaited<ReturnType<typeof listExercises>>["data"] = [];

if (!parsedId.success) {
  notFound = true;
} else if (!supabase) {
  loadError = "Templates are unavailable. Check Supabase configuration.";
} else {
  const [{ data: templateData, error: templateError }, { data: exercises, error: exercisesError }] = await Promise.all([
    getTemplate(supabase, parsedId.data),
    listExercises(supabase, {}),
  ]);

  template = templateData;
  availableExercises = exercises ?? [];
  loadError = templateError ?? exercisesError;

  if (!template || (userId && template.trainer_id !== userId)) {
    notFound = true;
  }
}

const updated = Astro.url.searchParams.get("updated") === "1";
---

<Layout title={template ? `Edit ${template.name}` : "Template not found"}>
  <div class="bg-background min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-4xl space-y-6">
      <div>
        <a href="/trainer/templates" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
          ← Back to templates
        </a>
        <h1 class="headline-lg text-foreground mt-3">
          {notFound ? "Template not found" : "Edit template"}
        </h1>
        {
          template ? (
            <p class="text-muted-foreground mt-1 text-sm">Update {template.name} or delete it from your library.</p>
          ) : null
        }
      </div>

      {
        updated ? (
          <div class="border-success/30 bg-success/10 text-success rounded-lg border px-4 py-3 text-sm">
            Template updated successfully.
          </div>
        ) : null
      }

      {
        notFound ? (
          <div class="border-border bg-card text-muted-foreground rounded-2xl border p-8 text-center">
            <p class="text-foreground text-lg font-medium">This template could not be found</p>
            <p class="mt-2 text-sm">It may have been deleted or the link is invalid.</p>
            <a
              href="/trainer/templates"
              class="border-border hover:bg-accent mt-4 inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
            >
              Back to templates
            </a>
          </div>
        ) : loadError ? (
          <div class="border-destructive/30 bg-destructive/10 text-destructive rounded-lg border px-4 py-3 text-sm">
            Failed to load template: {loadError}
          </div>
        ) : template ? (
          <div class="border-border bg-card rounded-2xl border p-6 backdrop-blur-xl">
            <TemplateForm
              client:load
              mode="edit"
              templateId={template.id}
              availableExercises={availableExercises}
              initialTemplate={{
                name: template.name,
                description: template.description,
                exercises: template.exercises,
              }}
            />
          </div>
        ) : null
      }
    </div>
  </div>
</Layout>
