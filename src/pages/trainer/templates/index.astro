---
import Layout from "@/layouts/Layout.astro";
import TemplatesHub from "@/components/session-templates/TemplatesHub";
import { searchParamsToFilters } from "@/lib/session-templates/filter-url";
import { filterTemplateSummaries } from "@/lib/session-templates/filter";
import { listExercises } from "@/lib/exercises/service";
import { listTemplateSummaries } from "@/lib/session-templates/service";
import { createClient } from "@/lib/supabase";

const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const initialFilters = searchParamsToFilters(Astro.url.searchParams);

let templateRows: Awaited<ReturnType<typeof listTemplateSummaries>>["data"] = [];
let availableExercises: Awaited<ReturnType<typeof listExercises>>["data"] = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = "Templates are unavailable. Check Supabase configuration.";
} else if (!userId) {
  loadError = "You must be signed in to view templates.";
} else {
  const [{ data: templates, error: templatesError }, { data: exercises, error: exercisesError }] = await Promise.all([
    listTemplateSummaries(supabase, userId),
    listExercises(supabase, {}),
  ]);

  templateRows = filterTemplateSummaries(templates ?? [], initialFilters);
  availableExercises = exercises ?? [];
  loadError = templatesError ?? exercisesError;
}

const hasActiveFilters = initialFilters.phase !== undefined || initialFilters.q !== undefined;
---

<Layout title="Session templates">
  <div class="bg-background min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-6xl">
      {
        loadError ? (
          <div class="border-destructive/30 bg-destructive/10 text-destructive rounded-lg border px-4 py-3 text-sm">
            Failed to load templates: {loadError}
          </div>
        ) : (
          <TemplatesHub
            client:load
            initialTemplates={templateRows}
            availableExercises={availableExercises}
            initialFilters={initialFilters}
            hasActiveFilters={hasActiveFilters}
          />
        )
      }
    </div>
  </div>
</Layout>
