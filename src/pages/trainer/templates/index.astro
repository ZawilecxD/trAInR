---
import Layout from "@/layouts/Layout.astro";
import { listTemplates } from "@/lib/session-templates/service";
import { createClient } from "@/lib/supabase";

const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let templateRows: Awaited<ReturnType<typeof listTemplates>>["data"] = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = "Templates are unavailable. Check Supabase configuration.";
} else if (!userId) {
  loadError = "You must be signed in to view templates.";
} else {
  const { data, error } = await listTemplates(supabase, userId);
  templateRows = data ?? [];
  loadError = error;
}

const created = Astro.url.searchParams.get("created") === "1";
const updated = Astro.url.searchParams.get("updated") === "1";
const deleted = Astro.url.searchParams.get("deleted") === "1";

const flashMessage = created
  ? "Template created successfully."
  : updated
    ? "Template updated successfully."
    : deleted
      ? "Template deleted."
      : null;
---

<Layout title="Session templates">
  <div class="bg-cosmic min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-6xl space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Session templates
          </h1>
          <p class="mt-1 text-sm text-blue-100/70">
            Build reusable session blueprints with warm-up, main, and cool-down phases.
          </p>
        </div>
        <a
          href="/trainer/templates/new"
          class="rounded-lg bg-purple-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500/90"
        >
          New template
        </a>
      </div>

      {
        flashMessage ? (
          <div class="rounded-lg border border-green-400/30 bg-green-500/10 px-4 py-3 text-sm text-green-100">
            {flashMessage}
          </div>
        ) : null
      }

      {
        loadError ? (
          <div class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            Failed to load templates: {loadError}
          </div>
        ) : null
      }

      {
        !loadError ? (
          templateRows.length === 0 ? (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-blue-100/80">
              <p class="text-lg font-medium text-white">No templates yet</p>
              <p class="mt-2 text-sm">Create your first template to reuse session structures across clients.</p>
              <a
                href="/trainer/templates/new"
                class="mt-4 inline-block rounded-lg border border-white/20 px-4 py-2 text-sm transition-colors hover:bg-white/10"
              >
                Create template
              </a>
            </div>
          ) : (
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/5">
              <div class="overflow-x-auto">
                <table class="min-w-full text-left text-sm text-blue-100/90">
                  <thead class="border-b border-white/10 bg-white/5 text-xs tracking-wide text-blue-100/60 uppercase">
                    <tr>
                      <th class="px-4 py-3">Name</th>
                      <th class="px-4 py-3">Description</th>
                      <th class="px-4 py-3">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {templateRows.map((template) => (
                      <tr class="border-b border-white/5 last:border-b-0">
                        <td class="px-4 py-3 font-medium text-white">{template.name}</td>
                        <td class="px-4 py-3">{template.description ?? "—"}</td>
                        <td class="px-4 py-3">
                          <a
                            href={`/trainer/templates/${template.id}`}
                            class="rounded-md border border-white/20 px-3 py-1 text-xs transition-colors hover:bg-white/10"
                          >
                            Edit
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )
        ) : null
      }
    </div>
  </div>
</Layout>
