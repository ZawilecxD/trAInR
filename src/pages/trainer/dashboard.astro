---
import Layout from "@/layouts/Layout.astro";
import TrainerDashboardOverview from "@/components/trainer/TrainerDashboardOverview.astro";
import { getTrainerDashboard } from "@/lib/trainer-dashboard/service";
import { createClient } from "@/lib/supabase";

const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadError: string | null = null;
let dashboard: Awaited<ReturnType<typeof getTrainerDashboard>>["data"] = null;

if (!supabase) {
  loadError = "Dashboard is unavailable. Check Supabase configuration.";
} else if (!userId) {
  loadError = "You must be signed in to view the dashboard.";
} else {
  const result = await getTrainerDashboard(supabase, userId);
  loadError = result.error;
  dashboard = result.data;
}
---

<Layout title="Dashboard">
  <div class="bg-background min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-6xl">
      {
        loadError ? (
          <div class="border-destructive/30 bg-destructive/10 text-destructive rounded-lg border px-4 py-3 text-sm">
            Failed to load dashboard: {loadError}
          </div>
        ) : dashboard ? (
          <TrainerDashboardOverview dashboard={dashboard} />
        ) : null
      }
    </div>
  </div>
</Layout>
