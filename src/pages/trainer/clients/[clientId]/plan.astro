---
import Layout from "@/layouts/Layout.astro";
import ClientPlanHub from "@/components/plans/ClientPlanHub";
import { isTrainerAssignedToClient } from "@/lib/client-plans/service";
import { toLocalISODate, visibleMonthRange } from "@/lib/dates";
import { listTemplates } from "@/lib/session-templates/service";
import { listSessionsForClient } from "@/lib/workout-sessions/service";
import { isoDateSchema } from "@/lib/workout-sessions/schemas";
import { createClient } from "@/lib/supabase";
import { z } from "zod";

const clientIdSchema = z.uuid();

const userId = Astro.locals.user?.id;
const parsedClientId = clientIdSchema.safeParse(Astro.params.clientId);
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!parsedClientId.success || !supabase || !userId) {
  return Astro.redirect("/trainer/clients");
}

const clientId = parsedClientId.data;

const { assigned } = await isTrainerAssignedToClient(supabase, userId, clientId);
if (!assigned) {
  return Astro.redirect("/trainer/clients");
}

const dateParam = Astro.url.searchParams.get("date");
const parsedDate = isoDateSchema.safeParse(dateParam);
const selectedDate = parsedDate.success ? parsedDate.data : toLocalISODate(new Date());
const initialMonth = selectedDate.slice(0, 7);
const range = visibleMonthRange(Number(selectedDate.slice(0, 4)), Number(selectedDate.slice(5, 7)) - 1);

const profileResult = await supabase.from("profiles").select("display_name").eq("id", clientId).maybeSingle();
const clientName = typeof profileResult.data?.display_name === "string" ? profileResult.data.display_name : "Client";

const [{ data: sessions, error: sessionsError }, { data: templates, error: templatesError }] = await Promise.all([
  listSessionsForClient(supabase, userId, clientId, range.from, range.to),
  listTemplates(supabase, userId),
]);

const loadError = sessionsError ?? templatesError;
const showAssignedBanner = Astro.url.searchParams.get("assigned") === "1";
---

<Layout title={`${clientName} — Training plan`}>
  <div class="bg-background min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-6xl space-y-6">
      <div>
        <a href="/trainer/clients" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
          ← Back to clients
        </a>
        <h1 class="headline-lg text-foreground mt-3">
          {clientName}
        </h1>
        <p class="text-muted-foreground mt-1 text-sm">
          Assign and personalize workout sessions on the client calendar.
        </p>
      </div>

      {
        loadError ? (
          <div class="border-destructive/30 bg-destructive/10 text-destructive rounded-lg border px-4 py-3 text-sm">
            Failed to load plan: {loadError}
          </div>
        ) : (
          <ClientPlanHub
            client:load
            clientId={clientId}
            clientName={clientName}
            initialSessions={(sessions ?? []).map((session) => ({
              ...session,
              name: session.name ?? "Workout",
            }))}
            initialSelectedDate={selectedDate}
            initialMonth={initialMonth}
            templates={templates ?? []}
            showAssignedBanner={showAssignedBanner}
          />
        )
      }
    </div>
  </div>
</Layout>
