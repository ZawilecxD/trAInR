---
import Layout from "@/layouts/Layout.astro";
import SessionForm from "@/components/workout-sessions/SessionForm";
import { isTrainerAssignedToClient } from "@/lib/client-plans/service";
import { listExercises } from "@/lib/exercises/service";
import { getTemplate, type TemplateWithExercises } from "@/lib/session-templates/service";
import { createClient } from "@/lib/supabase";
import { z } from "zod";

const clientIdSchema = z.uuid();
const templateIdSchema = z.uuid();
const isoDateSchema = z.string().regex(/^\d{4}-\d{2}-\d{2}$/);

const userId = Astro.locals.user?.id;
const parsedClientId = clientIdSchema.safeParse(Astro.params.clientId);
const supabase = createClient(Astro.request.headers, Astro.cookies);

const dateParam = Astro.url.searchParams.get("date");
const parsedDate = isoDateSchema.safeParse(dateParam);
const templateIdParam = Astro.url.searchParams.get("templateId");
const parsedTemplateId = templateIdParam ? templateIdSchema.safeParse(templateIdParam) : null;

if (!parsedClientId.success || !parsedDate.success || !supabase || !userId) {
  return Astro.redirect("/trainer/clients");
}

const clientId = parsedClientId.data;
const scheduledDate = parsedDate.data;

const { assigned } = await isTrainerAssignedToClient(supabase, userId, clientId);
if (!assigned) {
  return Astro.redirect("/trainer/clients");
}

let loadError: string | null = null;
let availableExercises: Awaited<ReturnType<typeof listExercises>>["data"] = [];
let initialSession: Pick<TemplateWithExercises, "name" | "exercises"> | undefined;
let sourceTemplateId: string | null = null;

const exercisesResult = await listExercises(supabase, {});
availableExercises = exercisesResult.data ?? [];
loadError = exercisesResult.error;

if (parsedTemplateId?.success) {
  const templateResult = await getTemplate(supabase, parsedTemplateId.data);
  loadError = loadError ?? templateResult.error;

  if (templateResult.data?.trainer_id === userId) {
    sourceTemplateId = templateResult.data.id;
    initialSession = {
      name: templateResult.data.name,
      exercises: templateResult.data.exercises,
    };
  }
}

const profileResult = await supabase.from("profiles").select("display_name").eq("id", clientId).maybeSingle();
const clientName = typeof profileResult.data?.display_name === "string" ? profileResult.data.display_name : "Client";
---

<Layout title={`New session — ${clientName}`}>
  <div class="bg-background min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-4xl space-y-6">
      <div>
        <a
          href={`/trainer/clients/${clientId}/plan?date=${scheduledDate}`}
          class="text-muted-foreground text-sm transition-colors hover:text-white"
        >
          ← Back to plan
        </a>
        <h1 class="headline-lg text-foreground mt-3">New session</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          {
            initialSession
              ? `Personalize "${initialSession.name}" before assigning to ${clientName}.`
              : `Build a blank session for ${clientName}.`
          }
        </p>
      </div>

      {
        loadError ? (
          <div class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            Failed to load editor: {loadError}
          </div>
        ) : (
          <div class="border-border bg-card rounded-2xl border p-6 backdrop-blur-xl">
            <SessionForm
              client:load
              mode="create"
              clientId={clientId}
              initialScheduledDate={scheduledDate}
              initialSourceTemplateId={sourceTemplateId}
              availableExercises={availableExercises}
              initialSession={initialSession}
            />
          </div>
        )
      }
    </div>
  </div>
</Layout>
