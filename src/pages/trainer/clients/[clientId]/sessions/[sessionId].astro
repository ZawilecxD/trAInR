---
import Layout from "@/layouts/Layout.astro";
import SessionActualsReview from "@/components/workout-sessions/SessionActualsReview";
import SessionCommentsThread from "@/components/session-comments/SessionCommentsThread";
import SessionForm from "@/components/workout-sessions/SessionForm";
import { getActivePlanForClient, isTrainerAssignedToClient } from "@/lib/client-plans/service";
import { listExercises } from "@/lib/exercises/service";
import { isSessionEditable } from "@/lib/workout-sessions/form-validation";
import { getSessionDetailForTrainer, getSessionWithExercises } from "@/lib/workout-sessions/service";
import { createClient } from "@/lib/supabase";
import { errorBannerClass, pageShellClass, surfaceCardClass } from "@/lib/ui-classes";
import { z } from "zod";

const clientIdSchema = z.uuid();
const sessionIdSchema = z.uuid();

const userId = Astro.locals.user?.id;
const parsedClientId = clientIdSchema.safeParse(Astro.params.clientId);
const parsedSessionId = sessionIdSchema.safeParse(Astro.params.sessionId);
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!parsedClientId.success || !parsedSessionId.success || !supabase || !userId) {
  return Astro.redirect("/trainer/clients");
}

const clientId = parsedClientId.data;
const sessionId = parsedSessionId.data;

const { assigned } = await isTrainerAssignedToClient(supabase, userId, clientId);
if (!assigned) {
  return Astro.redirect("/trainer/clients");
}

let loadError: string | null = null;
let notFound = false;
let editable = false;
let session: Awaited<ReturnType<typeof getSessionWithExercises>>["data"] = null;
let reviewSession: Awaited<ReturnType<typeof getSessionDetailForTrainer>>["data"] = null;
let availableExercises: Awaited<ReturnType<typeof listExercises>>["data"] = [];

const [{ data: sessionData, error: sessionError }, { data: plan }] = await Promise.all([
  getSessionWithExercises(supabase, sessionId),
  getActivePlanForClient(supabase, userId, clientId),
]);

session = sessionData;
loadError = sessionError;

if (session?.client_plan_id !== plan?.id) {
  notFound = true;
} else if (session) {
  editable = isSessionEditable(session);
}

if (!notFound && session && editable) {
  const { data: exercises, error: exercisesError } = await listExercises(supabase, {});
  availableExercises = exercises ?? [];
  loadError = loadError ?? exercisesError;
} else if (!notFound && session && !editable) {
  const { data: trainerDetail, error: detailError } = await getSessionDetailForTrainer(
    supabase,
    userId,
    clientId,
    sessionId,
  );

  if (!trainerDetail) {
    notFound = true;
  } else {
    reviewSession = trainerDetail;
  }

  loadError = loadError ?? detailError;
}

const profileResult = await supabase.from("profiles").select("display_name").eq("id", clientId).maybeSingle();
const clientName = typeof profileResult.data?.display_name === "string" ? profileResult.data.display_name : "Client";
const scheduledDate = session?.scheduled_date ?? "";
const pageTitle = notFound
  ? "Session not found"
  : editable
    ? `Edit ${session?.name ?? "session"}`
    : `Review ${session?.name ?? "session"}`;
---

<Layout title={pageTitle}>
  <div class:list={pageShellClass}>
    <div class="mx-auto max-w-4xl space-y-6">
      <div>
        <a
          href={`/trainer/clients/${clientId}/plan${scheduledDate ? `?date=${scheduledDate}` : ""}`}
          class="text-muted-foreground hover:text-foreground text-sm transition-colors"
        >
          ← Back to plan
        </a>
        <h1 class="headline-lg text-foreground mt-3 text-balance">
          {notFound ? "Session not found" : editable ? "Edit session" : "Session review"}
        </h1>
        {
          session ? (
            <p class="text-muted-foreground mt-1 text-sm">
              {editable
                ? `Update ${session.name} for ${clientName}.`
                : `Prescribed vs actual for ${session.name ?? "this session"} — ${clientName}.`}
            </p>
          ) : null
        }
      </div>

      {
        notFound ? (
          <div class:list={[surfaceCardClass, "border-dashed px-6 py-10 text-center"]}>
            <p class="text-foreground text-lg font-medium">This session could not be found</p>
            <p class="text-muted-foreground mt-2 text-sm">
              It may have been deleted or does not belong to this client.
            </p>
            <a
              href={`/trainer/clients/${clientId}/plan`}
              class="border-border hover:bg-accent mt-4 inline-flex min-h-11 items-center rounded-[var(--radius)] border px-4 text-sm transition-colors"
            >
              Back to plan
            </a>
          </div>
        ) : loadError ? (
          <div class:list={errorBannerClass}>Failed to load session: {loadError}</div>
        ) : reviewSession ? (
          <SessionActualsReview client:load session={reviewSession} sessionId={sessionId} currentUserId={userId} />
        ) : session ? (
          <>
            <SessionForm
              client:load
              mode="edit"
              clientId={clientId}
              sessionId={sessionId}
              exerciseSource="session"
              initialScheduledDate={session.scheduled_date}
              availableExercises={availableExercises}
              initialSession={{
                name: session.name ?? "Workout",
                exercises: session.exercises,
              }}
            />
            <SessionCommentsThread client:load sessionId={sessionId} currentUserId={userId} />
          </>
        ) : null
      }
    </div>
  </div>
</Layout>
