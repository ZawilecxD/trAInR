---
import Layout from "@/layouts/Layout.astro";
import InviteClientPanel from "@/components/trainer/InviteClientPanel";
import type { ActiveClientPlan } from "@/lib/client-plans/service";
import { mapAssignmentsToRoster } from "@/lib/trainer/clients-roster";
import { createClient } from "@/lib/supabase";
import type { InviteLink, Profile, TrainerClient } from "@/types";

const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const origin = Astro.url.origin;

let invites: InviteLink[] = [];
let assignments: TrainerClient[] = [];

if (supabase && userId) {
  const invitesResult = await supabase
    .from("invite_links")
    .select("*")
    .eq("trainer_id", userId)
    .order("created_at", { ascending: false });

  if (!invitesResult.error) {
    invites = invitesResult.data as InviteLink[];
  }

  const clientsResult = await supabase
    .from("trainer_clients")
    .select("*")
    .eq("trainer_id", userId)
    .eq("status", "active")
    .order("assigned_at", { ascending: false });

  if (!clientsResult.error) {
    assignments = clientsResult.data as TrainerClient[];
  }
}

const clientIds = assignments.map((row) => row.client_id);
let profileById: Record<string, Pick<Profile, "display_name">> = {};
let planByClientId = new Map<string, ActiveClientPlan>();

if (supabase && userId && clientIds.length > 0) {
  const [profilesResult, plansResult] = await Promise.all([
    supabase.from("profiles").select("id, display_name").in("id", clientIds),
    supabase
      .from("client_plans")
      .select("id, client_id, name, start_date")
      .eq("trainer_id", userId)
      .eq("status", "active")
      .in("client_id", clientIds),
  ]);

  if (!profilesResult.error) {
    const profiles = profilesResult.data as Pick<Profile, "id" | "display_name">[];
    for (const profile of profiles) {
      profileById[profile.id] = { display_name: profile.display_name };
    }
  }

  if (!plansResult.error) {
    const plans = plansResult.data as (ActiveClientPlan & { client_id: string })[];
    for (const plan of plans) {
      planByClientId.set(plan.client_id, {
        id: plan.id,
        name: plan.name,
        start_date: plan.start_date,
      });
    }
  }
}

const clients = mapAssignmentsToRoster(assignments, profileById, planByClientId);
---

<Layout title="Clients">
  <div class="bg-background min-h-screen p-4 md:p-8">
    <div
      class="border-border bg-muted text-foreground mx-auto w-full max-w-4xl rounded-2xl border p-6 backdrop-blur-xl md:p-8"
    >
      <div class="mb-8">
        <h1 class="headline-lg text-foreground text-2xl md:text-3xl">Clients</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          Manage invites, view assigned clients, and open plan calendars.
        </p>
      </div>

      <InviteClientPanel invites={invites} clients={clients} origin={origin} client:load />
    </div>
  </div>
</Layout>
