---
import Layout from "@/layouts/Layout.astro";
import ExerciseForm from "@/components/exercises/ExerciseForm";
import Topbar from "@/components/Topbar.astro";
import { exerciseIdParamSchema } from "@/lib/exercises/schemas";
import { getExercise, type ExerciseWithMuscleGroups } from "@/lib/exercises/service";
import { createClient } from "@/lib/supabase";
import type { MuscleGroup } from "@/types";

const rawId = Astro.params.id;
const parsedId = exerciseIdParamSchema.safeParse(rawId);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let exercise: ExerciseWithMuscleGroups | null = null;
let muscleGroupRows: MuscleGroup[] = [];
let loadError: string | null = null;
let notFound = false;

if (!parsedId.success) {
  notFound = true;
} else if (!supabase) {
  loadError = "Exercise library is unavailable. Check Supabase configuration.";
} else {
  const [{ data: exerciseData, error: exerciseError }, { data: muscleGroups, error: muscleError }] = await Promise.all([
    getExercise(supabase, parsedId.data),
    supabase.from("muscle_groups").select("id, name, region").order("name"),
  ]);

  exercise = exerciseData;
  muscleGroupRows = muscleGroups ?? [];
  loadError = exerciseError ?? muscleError?.message ?? null;
  notFound = !exercise;
}
---

<Layout title={exercise ? `Edit ${exercise.name}` : "Exercise not found"}>
  <div class="bg-cosmic min-h-screen p-4 md:p-8">
    <Topbar />
    <div class="mx-auto max-w-3xl space-y-6">
      <div>
        <a href="/trainer/exercises" class="text-sm text-blue-100/70 transition-colors hover:text-white">
          ← Back to exercise library
        </a>
        <h1 class="mt-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {notFound ? "Exercise not found" : "Edit exercise"}
        </h1>
        {
          exercise ? (
            <p class="mt-1 text-sm text-blue-100/70">Update {exercise.name} or archive it from your library.</p>
          ) : null
        }
      </div>

      {
        notFound ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-blue-100/80">
            <p class="text-lg font-medium text-white">This exercise could not be found</p>
            <p class="mt-2 text-sm">It may have been archived or the link is invalid.</p>
            <a
              href="/trainer/exercises"
              class="mt-4 inline-block rounded-lg border border-white/20 px-4 py-2 text-sm transition-colors hover:bg-white/10"
            >
              Back to exercise library
            </a>
          </div>
        ) : loadError ? (
          <div class="rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            Failed to load exercise: {loadError}
          </div>
        ) : exercise ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
            <ExerciseForm
              client:load
              mode="edit"
              exerciseId={exercise.id}
              muscleGroups={muscleGroupRows}
              initialExercise={exercise}
            />
          </div>
        ) : null
      }
    </div>
  </div>
</Layout>
