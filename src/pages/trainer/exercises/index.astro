---
import Layout from "@/layouts/Layout.astro";
import ExercisesHub from "@/components/exercises/ExercisesHub";
import { searchParamsToFilters } from "@/lib/exercises/filter-url";
import { parseListExercisesQuery } from "@/lib/exercises/schemas";
import { listExercises } from "@/lib/exercises/service";
import { createClient } from "@/lib/supabase";
import { errorBannerClass, pageShellClass, successBannerClass } from "@/lib/ui-classes";
import type { MuscleGroup } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

const parsedQuery = supabase ? parseListExercisesQuery(Astro.url.searchParams) : null;
const filters = parsedQuery?.success ? parsedQuery.data : {};

let exerciseRows: Awaited<ReturnType<typeof listExercises>>["data"] = [];
let muscleGroupRows: MuscleGroup[] = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = "Exercise library is unavailable. Check Supabase configuration.";
} else {
  const [{ data: exercises, error: listError }, { data: muscleGroups, error: muscleError }] = await Promise.all([
    listExercises(supabase, filters),
    supabase.from("muscle_groups").select("id, name, region").order("name"),
  ]);

  exerciseRows = exercises ?? [];
  muscleGroupRows = muscleGroups ?? [];
  loadError = listError ?? muscleError?.message ?? null;
}

const muscleGroupNameById = Object.fromEntries(muscleGroupRows.map((group) => [group.id, group.name]));
const initialFilters = searchParamsToFilters(Astro.url.searchParams);

const successParam = Astro.url.searchParams.get("success");
const created = Astro.url.searchParams.get("created") === "1";
const updated = Astro.url.searchParams.get("updated") === "1";
const archived = Astro.url.searchParams.get("archived") === "1";

const flashMessage = created
  ? "Exercise created successfully."
  : updated
    ? "Exercise updated successfully."
    : archived
      ? "Exercise archived."
      : successParam;

const hasActiveFilters =
  initialFilters.type !== undefined ||
  initialFilters.q !== undefined ||
  initialFilters.muscleGroupIds.length > 0 ||
  initialFilters.favouritesOnly === true;
---

<Layout title="Exercise library">
  <div class:list={pageShellClass}>
    <div class="mx-auto max-w-6xl space-y-6">
      {flashMessage ? <div class:list={successBannerClass}>{flashMessage}</div> : null}

      {loadError ? <div class:list={errorBannerClass}>Failed to load exercises: {loadError}</div> : null}

      {
        !loadError ? (
          <ExercisesHub
            client:load
            initialExercises={exerciseRows}
            muscleGroups={muscleGroupRows}
            initialFilters={initialFilters}
            hasActiveFilters={hasActiveFilters}
            muscleGroupNameById={muscleGroupNameById}
          />
        ) : null
      }
    </div>
  </div>
</Layout>
