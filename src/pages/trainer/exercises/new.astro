---
import Layout from "@/layouts/Layout.astro";
import ExerciseForm from "@/components/exercises/ExerciseForm";
import { createClient } from "@/lib/supabase";
import type { MuscleGroup } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let muscleGroupRows: MuscleGroup[] = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = "Exercise library is unavailable. Check Supabase configuration.";
} else {
  const { data: muscleGroups, error } = await supabase.from("muscle_groups").select("id, name, region").order("name");
  muscleGroupRows = muscleGroups ?? [];
  loadError = error?.message ?? null;
}
---

<Layout title="New exercise">
  <div class="bg-background min-h-screen p-4 md:p-8">
    <div class="mx-auto max-w-3xl space-y-6">
      <div>
        <a href="/trainer/exercises" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
          ← Back to exercise library
        </a>
        <h1 class="headline-lg text-foreground mt-3">New exercise</h1>
        <p class="text-muted-foreground mt-1 text-sm">Add a new exercise to your library.</p>
      </div>

      {
        loadError ? (
          <div class="border-destructive/30 bg-destructive/10 text-destructive rounded-lg border px-4 py-3 text-sm">
            Failed to load muscle groups: {loadError}
          </div>
        ) : (
          <div class="border-border bg-card rounded-2xl border p-6 backdrop-blur-xl">
            <ExerciseForm client:load mode="create" muscleGroups={muscleGroupRows} />
          </div>
        )
      }
    </div>
  </div>
</Layout>
